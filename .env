# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> DOCKER ###
DOCKER_PHP_VERSION=8.5

DATABASE_VERSION=${POSTGRESQL_ADDON_VERSION:-18.4}
DATABASE_USER=${POSTGRESQL_ADDON_USER:-docker}
DATABASE_PASSWORD=${POSTGRESQL_ADDON_PASSWORD:-docker}
DATABASE_HOST=${POSTGRESQL_ADDON_HOST:-pgsql}
DATABASE_PORT=${POSTGRESQL_ADDON_PORT:-5432}
DATABASE_NAME=${POSTGRESQL_ADDON_DB:-ardennesetape}

RABBITMQ_VERSION=3.13
RABBITMQ_USER=docker
RABBITMQ_PASSWORD=docker
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
###< DOCKER ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/%2f"
AMQP_CHANNEL_SUFFIX=
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
#DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app/gateways ###
# The four external services the path 4 aggregates are assembled from, plus the notification
# provider the path 5 outbox delivers to. Placeholders: nothing in dev or test reaches them,
# because the InMemory* adapters are the ones registered there (see the #[When] attributes).
BILLING_BASE_URI=https://billing.fake/v1/
BILLING_TOKEN=
CATALOGUE_BASE_URI=https://catalogue.fake/v1/
CATALOGUE_TOKEN=
MODERATION_BASE_URI=https://moderation.fake/v1/
MODERATION_TOKEN=
IDENTITY_BASE_URI=https://identity.fake/v1/
IDENTITY_TOKEN=
NOTIFICATIONS_BASE_URI=https://notifications.fake/v1/
NOTIFICATIONS_TOKEN=
###< app/gateways ###

###> lexik/jwt-authentication-bundle ###
# The key material ADR 009 rule 9's bearer token is signed with. Neither file is committed
# (.gitignore ignores config/jwt/*.pem), so a fresh clone has to make its own:
#
#     php bin/console lexik:jwt:generate-keypair
#
# The recipe writes a random passphrase here. It is replaced by an empty placeholder, which is the
# same shape `APP_SECRET=` ships in: a real one belongs in .env.local, which is not committed
# either, and a value in .env is a secret published to everybody who clones the repository. Empty
# means the generated private key is not itself encrypted, which is what a disposable development
# keypair is. The passphrase here and the one the keypair was generated with have to agree, or
# `AccessTokens::issue()` fails loudly; `php bin/console lexik:jwt:check-config` is the bundle's own
# way of asking whether they do.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> boilerplate ###
# The JWT keypair is NOT committed. Generate your own before using the `api` firewall:
#   php bin/console lexik:jwt:generate-keypair
# It writes config/jwt/{private,public}.pem, which .gitignore already excludes.
###< boilerplate ###
