{
    "name": "gheb/ddd-cqs-boilerplate",
    "description": "A DDD + CQS starting point for Symfony and API Platform: the shared machinery, the architecture rules that keep it honest, and the ADRs that argue for every one of them.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "ddd",
        "cqs",
        "cqrs",
        "hexagonal",
        "symfony",
        "api-platform",
        "ecotone",
        "adr",
        "boilerplate"
    ],
    "authors": [
        {
            "name": "Gr\u00e9goire H\u00e9bert"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-amqp": "*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/documentation": "4.3.17",
        "api-platform/http-cache": "4.3.17",
        "api-platform/hydra": "4.3.17",
        "api-platform/json-schema": "4.3.17",
        "api-platform/jsonld": "4.3.17",
        "api-platform/metadata": "4.3.17",
        "api-platform/openapi": "4.3.17",
        "api-platform/serializer": "4.3.17",
        "api-platform/state": "4.3.17",
        "api-platform/symfony": "4.3.17",
        "api-platform/validator": "4.3.17",
        "doctrine/dbal": "^3.9.4",
        "doctrine/doctrine-bundle": "^2.19.1",
        "doctrine/doctrine-migrations-bundle": "^3.7.1",
        "doctrine/orm": "^3.7.1",
        "ecotone/dbal": "^1.326.1",
        "ecotone/jms-converter": "^1.326.1",
        "ecotone/symfony-bundle": "^1.326.1",
        "lexik/jwt-authentication-bundle": "^3.2",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/amqp-messenger": "7.4.*",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/flex": "^2.7.1",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*",
        "webmozart/assert": "^1.11"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "ApiPlatform\\": "src/Shared/Infrastructure/ApiPlatform/",
            "Translation\\": "src/Shared/Infrastructure/Translation/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Tests\\Architecture\\": "tests/phpstan/Architecture/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "ekino/phpstan-banned-code": "*",
        "phpat/phpat": "^0.11",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2.14",
        "phpstan/phpstan-doctrine": "*",
        "phpstan/phpstan-symfony": "*",
        "phpunit/phpunit": "^12.5.35",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    }
}
